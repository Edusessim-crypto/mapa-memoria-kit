# Configuração do Mapa do Segundo Cérebro — fica em ~/.config/segundo-cerebro/elevenlabs.env (fora do vault).
# Linhas com # são comentários. Nunca coloque este arquivo dentro do vault nem no git.

# --- Quem é você (o Jarvis chama você por este nome)
SC_NOME=Roberto

# --- Voz do Jarvis (ElevenLabs) — sem estes dois, o mapa usa as vozes do próprio Mac
ELEVENLABS_API_KEY=
# nome da voz como aparece em "My Voices" na sua conta, ou o ID da voz (20 caracteres)
ELEVENLABS_VOZ=
# opcional: como o nome da voz aparece na tela (padrão: "Jarvis" quando a voz é por ID)
ELEVENLABS_VOZ_NOME=Jarvis
# opcional: modelo de voz (padrão eleven_multilingual_v2); ELEVENLABS_MODELO_RESPOSTA vale só para as respostas da conversa
ELEVENLABS_MODELO=eleven_multilingual_v2
#ELEVENLABS_MODELO_RESPOSTA=eleven_multilingual_v2

# --- Conversa com o Claude (usa o login do Claude Code deste Mac; não precisa de chave de API)
# modelo da conversa por voz: sonnet (padrão), haiku ou opus
SC_IA_MODELO=sonnet
# raciocínio: low (mais rápido, padrão), medium ou high
SC_IA_ESFORCO=low
# caminho do executável "claude", só se o app não o encontrar sozinho
#SC_CLAUDE=/caminho/para/claude
# modelo usado para escrever a saudação de abertura e o roteiro da apresentação (padrão: SC_IA_MODELO)
#SC_SAUDACAO_MODELO=sonnet
#SC_ROTEIRO_MODELO=sonnet

# --- Liga/desliga
# 0 = não escrever/gravar o roteiro narrado da apresentação em segundo plano (gasta Claude + ElevenLabs)
SC_ROTEIRO=1
# 0 = não abrir a sessão do Claude ao iniciar o app (a primeira pergunta demora mais)
SC_AQUECER=1
# conectores MCP permitidos na conversa por voz (só consulta), separados por vírgula
#SC_FERRAMENTAS_EXTRA=
# 1 = conversa simulada, sem Claude (só para testes e demonstração)
#SC_CONVERSA_SIMULADA=0
